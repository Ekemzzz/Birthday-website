# Wishes are stored privately in Supabase. Visitors can INSERT a wish but can
# NEVER read them — that is enforced by Row Level Security on the wishes table.
#
# 1. Create a free project at https://supabase.com
# 2. In the SQL Editor, create the "wishes" table + RLS policies (see project notes).
# 3. Copy your Project URL and anon/public key from: Project Settings -> API
# 4. Paste them below, save this file as ".env", and restart the dev server.
#
# The anon key is safe to expose in the browser because RLS blocks all reads.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
